sysctl -w net.ipv4.ip_forward=1

ip a add 10.0.1.1/30 dev eth0
ip link set dev eth0 up
ip a add 10.0.2.1/30 dev eth1
ip link set dev eth1 up
ip a add 10.0.3.1/30 dev eth2
ip link set dev eth2 up
ip a add 10.0.4.1/30 dev eth3
ip link set dev eth3 up
ip a add 10.0.5.1/30 dev eth4
ip link set dev eth4 up
ip a add 10.0.6.1/30 dev eth5
ip link set dev eth5 up
ip a add 10.0.7.1/30 dev eth6
ip link set dev eth6 up
ip a add 10.0.8.1/30 dev eth7
ip link set dev eth7 up

ip route add 192.168.100.0/25 via 10.0.1.2
ip route add 192.168.100.128/26 via 10.0.2.2
ip route add 192.168.100.192/26 via 10.0.3.2
ip route add 192.168.101.0/27 via 10.0.4.2
ip route add 192.168.101.32/28 via 10.0.5.2
ip route add 192.168.101.48/28 via 10.0.6.2
ip route add 192.168.101.64/28 via 10.0.7.2
ip route add 192.168.101.80/28 via 10.0.8.2

apt update
apt install isc-dhcp-server -y

cp /shared/dhcpd.conf /etc/dhcp/dhcpd.conf
cp /shared/isc-dhcp-server /etc/default/isc-dhcp-server

/etc/init.d/isc-dhcp-server start




cp /shared/resolv.conf /etc/resolv.conf